# ── Base de datos ────────────────────────────────────────────────────
# Vacío  => PGlite local en ./.data/pglite (no hace falta instalar nada)
# Con URL => Postgres / Supabase. Las mismas migraciones corren en ambos.
DATABASE_URL=

# ── Sesión ───────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Se deja VACÍA a propósito: si acá
# hubiera un valor de ejemplo, alguien podría desplegar con una clave que
# está publicada en este repo y cualquiera podría firmarse una sesión.
# Sin clave la app no arranca y avisa. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Horas que dura la sesión de la coordinadora. La del vigilador no vence.
SESION_ADMIN_HORAS=12
