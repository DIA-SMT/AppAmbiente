{
  "name": "app-ambiente-smt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registro y trazabilidad de residuos — Secretaría de Ambiente y Desarrollo Sustentable, Municipalidad de San Miguel de Tucumán",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrar": "tsx db/cli/migrar.ts",
    "db:sembrar": "tsx db/cli/sembrar.ts",
    "db:sql": "tsx db/cli/exportar-sql.ts",
    "db:usuarios": "tsx db/cli/limpiar-usuarios.ts",
    "db:reset": "tsx db/cli/reset.ts",
    "preparar": "npm run db:migrar && npm run db:sembrar",
    "db:verificar": "tsx db/cli/verificar.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
