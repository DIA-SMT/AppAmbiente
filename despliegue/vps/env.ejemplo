# /srv/ambiente/compartido/.env — dueño ambiente, permisos 600.
#
# Sólo nombres: los valores se escriben a mano en el servidor, nunca en el
# repositorio ni en un chat.

NODE_ENV="production"

# La base sigue en Supabase: la cadena del pooler en modo transacción (puerto
# 6543). Sin esta línea la app no arranca y /api/salud contesta 503.
DATABASE_URL=""

# Una clave propia de la VPS (un secreto por entorno). Cambiarla cierra todas
# las sesiones, también las de los celulares de los puntos:
#   openssl rand -base64 48
AUTH_SECRET=""

# Migue, con la clave de OpenRouter. Vacío apaga a Migue y el resto anda igual.
OPENROUTER_API_KEY=""
ASISTENTE_MODELO=""
ASISTENTE_ESFUERZO=""
ASISTENTE_TOPE_MENSUAL_USD=""
