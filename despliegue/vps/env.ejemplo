# /srv/ambiente/compartido/.env — dueño ambiente, permisos 600.
#
# Sólo nombres: los valores se escriben a mano en el servidor, nunca en el
# repositorio ni en un chat.

NODE_ENV="production"

# La base sigue en Supabase: la MISMA cadena del pooler (puerto 6543) que usa
# Vercel. Sin esta línea la app no avisa: arranca con una base PGlite vacía en
# el disco. Verificar con /api/salud que diga "motor": "postgres".
DATABASE_URL=""

# Una clave NUEVA para la VPS, no la de Vercel (un secreto por entorno):
#   openssl rand -base64 48
AUTH_SECRET=""

# Migue. Puede ser la misma clave de OpenRouter que en Vercel; vacío apaga a
# Migue y el resto anda igual.
OPENROUTER_API_KEY=""
ASISTENTE_MODELO=""
ASISTENTE_ESFUERZO=""
ASISTENTE_TOPE_MENSUAL_USD=""
